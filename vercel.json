{
  "framework": "vite",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/api/product-image/(.*)",
      "destination": "/api/product-image?id=$1"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai-chat"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/product/(.*)",
      "destination": "/api/render?type=product&slug=$1"
    },
    {
      "source": "/category/(.*)",
      "destination": "/api/render?type=category&slug=$1"
    },
    {
      "source": "/",
      "destination": "/api/render?type=home"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
